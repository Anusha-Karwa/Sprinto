# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Checked against ai.google.dev / aistudio.google.com docs on 2026-11-15:
#   gemini-3.5-flash-lite = Google's recommended cost-effective model for new projects.
#   gemini-2.5-flash is DEPRECATED (auto-routes to 3.5-flash-lite from 2026-12-01) — do not use.
GEMINI_MODEL=gemini-3.5-flash-lite
# gemini-embedding-2: flexible 128–3072 dims; 768 is a recommended size and is auto-renormalised.
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# $ per 1M tokens, for cost reports (gemini-3.5-flash-lite paid tier, 2026-11-15)
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50

# Local dev default; replace with your Supabase connection string later.
DATABASE_URL=postgresql://sprinto:sprinto@localhost:5432/sprinto
TEST_DATABASE_URL=postgresql://sprinto:sprinto@localhost:5432/sprinto_test

HUNTER_API_KEY=
POC_SOURCE=hunter          # hunter | apollo_override
MY_EMAIL=                  # <-- your own inbox; the ONLY address any email or invite may go to
BOT_EMAIL=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GROWTH_LEAD_NAME=Anu
GROWTH_LEAD_TZ=Asia/Kolkata
REVIEWER_ID=anu
REVIEW_MODE=off            # off = case demo (auto-send to MY_EMAIL) | on = Phase B review queue
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36
# Optional: path to a Chromium binary for the JS-shell fallback (auto-detected if empty)
CHROMIUM_PATH=
ALERT_CHANNEL=email        # email | telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRM_PROVIDER=postgres      # postgres | hubspot
HUBSPOT_TOKEN=
